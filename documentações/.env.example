# =============================================================================
# Oráculo 360 Finaud — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com as credenciais reais.
# NUNCA commite o .env com valores reais no repositório.
# Consulte VARIAVEIS_AMBIENTE.md para descrição completa de cada variável.
# =============================================================================

# --- Inteligência Artificial (OpenAI) ---
# Usada nos scripts 07 (FogBugz), 15 (Aprendizados) e 16 (Resumos BACEN)
OPENAI_API_KEY=sk-proj-[sua-chave-aqui]

# --- Inteligência Artificial (Google Gemini) — alternativa ao OpenAI ---
GEMINI_API_KEY=AIzaSy[sua-chave-aqui]
GEMINI_MODEL=gemini-1.5-flash

# --- FogBugz ---
# Token de API: gerar em Configurações > API no FogBugz
FOGBUGZ_TOKEN=[seu-token-aqui]
# ID do filtro ativo (padrão: 218 — verificar em Configurações > Filtros)
FOGBUGZ_FILTER_ID=218

# --- Gmail (Coleta de E-mails via IMAP) ---
# App Password: gerar em Conta Google > Segurança > Senhas de app
GMAIL_USER=email-coleta@finaud.com.br
GMAIL_APP_PASS=[app-password-16-chars]

# --- E-mail (Envio de Alertas) ---
EMAIL_USER=alertas@finaud.com.br
EMAIL_PASS=[app-password-16-chars]
ADMIN_EMAIL=destinatario-alertas@finaud.com.br

# --- Google Chat (Coleta de Mensagens) ---
# JSON completo da Service Account do Google Cloud
# Gerar em: console.cloud.google.com > IAM > Service Accounts > Chaves
CHAT_CREDENTIALS_JSON={"type":"service_account","project_id":"[projeto]","private_key_id":"[id]","private_key":"-----BEGIN RSA PRIVATE KEY-----\n[chave]\n-----END RSA PRIVATE KEY-----\n","client_email":"[conta]@[projeto].iam.gserviceaccount.com","client_id":"[id]","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
